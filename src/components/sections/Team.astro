---
import SectionTitle from "../ui/SectionTitle.astro";
import TeamCard from "../ui/TeamCard.astro";
import Section from "./Section.astro";

const description =
  "Our core consultants are part of a broader community of practice working at the intersection of public health, artificial intelligence, and data systems. This team leverages two decades of global health experience to deliver strategic, technical, and operational leadership.";

// Team images
import cn from "../../assets/team/chas-nelson.jpg";
import gg from "../../assets/team/george-gazis.jpg";
import jc from "../../assets/team/jonjo-cordey.png";
import mk from "../../assets/team/mix-kundegorski.jpg";
import ta from "../../assets/team/toavina-andriamihaingo.jpg";

const team = [
  {
    pic: cn,
    name: "Dr Chas Nelson",
    role: "Data & AI Strategist",
    description:
      "Dr Chas Nelson is Fjelltopp's Director and Principal Consultant, providing strategic leadership for technology integration projects. Chas has a PhD in computing, 10+ years experience in data science across biomedicine and healthcare, and extensive experience building international data projects for international development and the public sector. He has also driven forward industry best practices and regulatory understanding in AI for health.",
    link: "/#contact",
  },
  {
    pic: mk,
    name: "Dr Mix Kundegorski",
    role: "Health Data Specialist",
    description:
      "Dr Mix Kundegorski has extensive experience in advanced statistical methods and artificial intelligence applications across diverse domains. His background includes over a decade of work in public health technology and disease control, supported by a PhD in mathematical ecology. His technical expertise, gained through work with WHO and FAO, provides him with a deep understanding of user requirements and challenges within knowledge-based organisations.",
    link: "/#contact",
  },
  {
    pic: ta,
    name: "Toavina Andriamihaingo",
    role: "Software Consultant",
    description:
      "Toavina is a full-stack software consultant based in Madagascar who holds a master's degree in Computer Science. Before joining Fjelltopp in 2022, he had accumulated over eight years of experience in public health information systems (HIS), data engineering, and software development. He spent three years at the Ministry of Public Health and over five years at the WHO, where he contributed to the development and management of numerous HIS, including DHIS2-based solutions. Since joining Fjelltopp, Toavina has applied this experience to international projects, including the UNAIDS AIDS Data Repository and various CKAN-based open data initiatives.",
    link: "/#contact",
  },
  {
    pic: gg,
    name: "Dr George Gazis",
    role: "Medical Ethics Advisor",
    description:
      "Dr George Alexander Gazis is Associate Professor in Greek Literature and Philosophy (Ethics) and Deputy Head of Department at Durham University. He is a lead reviewer for the Greater Manchester NHS Ethics committee and has worked as an ethics consultant on major medical research projects, including test and controlled trials.",
    link: "/#contact",
  },
  {
    pic: jc,
    name: "Jonjo Cordey",
    role: "Global Health Specialist",
    description:
      "Jonjo Cordey is a global health professional with over four years of experience working with the WHO, specialising in health security, emergency preparedness and response, and health systems strengthening. His work spans public health policy, research, data analysis, and programme coordination, supporting national governments and international partners to strengthen health system resilience.",
    link: "/#contact",
  },
];
---

<Section id="team">
  <div class="mt-[140px]">
    <SectionTitle sectionTitle="Team" description={description} />
    <div
      class="grid grid-cols-1 grid-rows-1 gap-10 md:grid-cols-2 xl:grid-cols-3"
    >
      {
        team.map((member) => (
          <a href={member.link} class="block">
            <TeamCard
              pic={member.pic}
              name={member.name}
              role={member.role}
              description={member.description}
            />
          </a>
        ))
      }
    </div>
  </div>
</Section>
