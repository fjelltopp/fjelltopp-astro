---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import HeroIlust from "../../assets/pics/people_front.jpeg";
---

<Section id="home">
  <div
    class="relative mt-[50px] flex flex-col-reverse items-center md:flex-row"
    id="hero"
  >
    <div class="row items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
      <div class="space-y-3 text-left">
        <h1
          class="text-center text-4xl font-medium leading-none md:text-left md:text-6xl"
        >
          Leveraging data<br />for public good
        </h1>
        <p
          class="mb-8 mt-6 text-center text-lg font-normal leading-7 sm:mb-12 md:pr-12 md:text-left"
        >
          We are Fjelltopp, a global health data consultancy specialising in
          data and AI solutions for health emergencies, surveillance, and
          digital health. We collaborate with WHO, UN agencies, and ministries
          of health to strengthen systems and drive informed action in complex
          settings.
        </p>
        <div
          class="inline-flex w-full items-center justify-center md:justify-start"
        >
          <a
            href="/#services"
            class="rounded-2xl border bg-zinc-900 px-8 py-5 text-center text-xl font-normal leading-7 text-white hover:bg-white hover:text-black"
            >Learn more
          </a>
        </div>
      </div>
    </div>
    <div class="flex items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
      <Image src={HeroIlust} alt="Hero Ilustration" loading="eager" />
    </div>
  </div>
</Section>
