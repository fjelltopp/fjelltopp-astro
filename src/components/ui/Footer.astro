---
import { Image } from "astro:assets";
import Facebook from "../../assets/facebook.svg";
import Linkedin from "../../assets/linkedin.svg";
import Logo from "../../assets/logo-white.png";
import Twitter from "../../assets/twitter.svg";

const logos = [
  {
    name: "Facebook",
    src: Facebook,
    link: "https://facebook.com/fjelltoppltd",
  },
  {
    name: "Linkedin",
    src: Linkedin,
    link: "https://www.linkedin.com/company/fjelltopp/",
  },
  { name: "Twitter", src: Twitter, link: "https://twitter.com/fjelltoppltd" },
];

const links = [
  { name: "About us", href: "/about" },
  { name: "Team", href: "/#team" },
  { name: "Services", href: "/#services" },
  { name: "Blog", href: "/articles" },
];
---

<section class="sm:px-5">
  <div class="mx-auto w-full max-w-[1240px]">
    <div
      class="bg-dark text-gray px-[15px] py-[55px] sm:rounded-t-[45px] lg:px-[60px]"
    >
      <div>
        <div
          class="flex flex-col items-center justify-between gap-7 lg:flex-row"
        >
          <picture>
            <a
              href="/"
              class="flex items-center space-x-3 rtl:space-x-reverse"
            >
              <Image
                class="h-16 w-auto"
                src={Logo}
                alt="Fjelltopp logo in white"
              />
            </a>
          </picture>
          <ul class="flex flex-col gap-5 sm:flex-row">
            {
              links.map((link) => {
                return (
                  <li class="text-center">
                    <a class="underline" href={link.href}>
                      {link.name}
                    </a>
                  </li>
                );
              })
            }
          </ul>
          <ul class="flex gap-5">
            {
              logos.map((logo) => {
                return (
                  <li>
                    <a href={logo.link} target="_blank">
                      <picture>
                        <Image src={logo.src} alt={logo.name} />
                      </picture>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="mb-[51px] mt-[66px] flex flex-col lg:flex-row">
          <div
            class="flex w-full flex-col text-center lg:w-[30%] lg:text-start"
          >
            <h3 class="text-green mb-5 text-center text-2xl md:text-left">
              Contact us
            </h3>
            <div
              class="flex flex-col justify-between gap-4 text-sm text-gray-200"
            >
              <span>Email: info@fjelltopp.org</span>
              <span class="lg:w-3/4">
                Registered office: 40 Blackburn Road, Padiham, Lancashire, BB12
                8JZ
              </span>
            </div>
          </div>
        </div>

        <div class="bg-gray mb-5 h-[1px]"></div>
        <div class="mt-4 text-center text-sm text-gray-400">
          Fjelltopp Ltd is registered in the United Kingdom. Company number
          11961922.<br />
          Registered office: 40 Blackburn Road, Padiham, Lancashire, BB12 8JZ.
        </div>
      </div>
    </div>
  </div>
</section>
