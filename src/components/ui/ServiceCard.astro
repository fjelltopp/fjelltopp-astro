---
import { splitTitle } from "../../utils/splitTitle";

import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";

/*
1. Gray card with green title and green on black icon
2. Green card with gray title and green on black icon
3. Black card with gray title and gray on black icon
*/

const { service } = Astro.props;

interface Props {
  service: CollectionEntry<"services">;
}
---

<Card isUnderline={false}>
  <a href={"/services/" + service.id} class="flex items-center gap-3.5">
    <div class="bg-gray flex h-[150px] w-full items-center rounded-[45px] p-8">
      <div class="flex w-1/2 justify-center">
        <h3 class="flex flex-col items-center text-center">
          <span
            class={`inline-block ${service.data.order % 3 === 1 ? "greenhead" : service.data.order % 3 === 2 ? "whitehead" : "blackhead"}`}
          >
            {splitTitle(service.data.title)[0]}
          </span>
          <span
            class={`inline-block ${service.data.order % 3 === 1 ? "greenhead" : service.data.order % 3 === 2 ? "whitehead" : "blackhead"}`}
          >
            {splitTitle(service.data.title)[1]}
          </span>
        </h3>
      </div>
      <div class="flex w-1/2 items-center justify-center">
        <picture class="flex items-center justify-center">
          <Image
            src={service.data.image}
            alt={service.data.alt}
            class="max-h-[100px] w-auto object-contain"
          />
        </picture>
      </div>
    </div>
  </a>
</Card>

<style>
  .custom-grid {
    grid-template: auto auto;
  }
</style>
